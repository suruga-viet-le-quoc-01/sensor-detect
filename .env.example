# === Sensor / Serial ===
COM_PORT=COM3
BAUD_RATE=256000
MACHINE_ID=CNC-07

# === Transport (kênh kết nối tới sensor) ===
# Danh mục đầy đủ + hướng dẫn dò UUID: docs/sensor-config/ble-transport.md
TRANSPORT=serial              # serial | ble
# --- BLE (chỉ dùng khi TRANSPORT=ble; SCAFFOLD — UUID cần xác nhận thực tế) ---
# ⚠️ Để giá trị THẬT TRỐNG (không gì sau dấu =, không comment cùng dòng) — python-dotenv
# không tách được comment `#...` khi giá trị để trống, comment sẽ bị đọc thành literal value.
# MAC/address BLE của sensor (dò bằng python -m src.workflows.ble_discover)
BLE_DEVICE_ADDRESS=
# TODO: CHƯA XÁC NHẬN — xem docs/sensor-config/ble-transport.md
BLE_SERVICE_UUID=
# TODO: CHƯA XÁC NHẬN — characteristic ghi lệnh
BLE_WRITE_CHAR_UUID=
# TODO: CHƯA XÁC NHẬN — characteristic nhận data
BLE_NOTIFY_CHAR_UUID=
BLE_PASSWORD=HiLink            # mật khẩu BLE mặc định (lệnh 0x00A8), đổi qua 0x00A9 nếu cần
BLE_SCAN_TIMEOUT_S=10

# === Session logic (giây) ===
PRESENCE_MIN_DURATION_S=4     # có người liên tục bao lâu mới mở session (lọc đi ngang)
DEBOUNCE_S=5                  # chờ sau khi mất tín hiệu mới đóng session
SENSOR_TIMEOUT_S=30           # không nhận frame quá lâu -> cảnh báo sensor chết
SHIFT_END_TIME=17:30         # giờ kết thúc ca (flush + đóng session mở)

# === Cấu hình nạp vào sensor — CHỈ dùng cho CLI `configure.py` ===
# ⚠️ NẾU BẠN CẤU HÌNH CẢM BIẾN QUA WEB (tab 設定, Web Serial) THÌ BỎ QUA CẢ KHỐI NÀY.
#    Cấu hình cảm biến (gate/sensitivity/resolution/no-one-duration) sống trong FLASH của cảm biến,
#    ghi bằng WEB hoặc `configure.py` — lần ghi cuối thắng. `run_reader` chỉ ĐỌC, không đụng flash,
#    và KHÔNG đọc các biến dưới đây → sửa ở đây KHÔNG có tác dụng nếu đã dùng web.
#    ⛔ Đừng chạy `configure.py` sau khi đã tune trên web: nó đọc .env (có thể cũ) rồi GHI ĐÈ flash.
# Danh mục đầy đủ: docs/sensor-config/configurable-items.md
RANGE_RESOLUTION=0.2         # 0.75 hoặc 0.2 (m/gate). Hiệu lực sau restart module
MAX_MOVING_GATE=3            # 2-8. 3 x 0.2m = phát hiện trong ~0.6m (loại người/vật xa hơn)
MAX_STATIC_GATE=3            # 2-8
NO_ONE_DURATION_S=5          # 0-65535 giây

# Sensitivity đồng loạt (áp mọi gate). Trống = giữ mặc định xuất xưởng. Giá trị: 0-100.
MOTION_SENSITIVITY=
STATIC_SENSITIVITY=
# Ghi đè theo từng gate (tuỳ chọn, ưu tiên hơn giá trị đồng loạt).
# JSON: gate->value, vd {"0":50,"1":50,"2":40,"8":15}. Static gate 0,1 KHÔNG đặt được. Trống = bỏ qua.
MOTION_SENSITIVITY_PER_GATE=
STATIC_SENSITIVITY_PER_GATE=
# Tự hiệu chỉnh nền thay cho set tay (yêu cầu KHÔNG có người khi chạy).
AUTO_CALIBRATE=false         # true = chạy background noise detection (0x000B)
AUTO_CALIBRATE_DURATION_S=10 # thời lượng đo nền

# Truyền thông / bảo mật (thường để mặc định)
BLUETOOTH_ENABLED=false      # false = tắt Bluetooth (khuyến nghị khi vận hành)

# Chân OUT + cảm biến ánh sáng (project đọc qua UART nên thường để tắt)
AUX_LIGHT_MODE=off           # off | below | above (kích khi sáng < / > ngưỡng)
AUX_LIGHT_THRESHOLD=128      # 0-255
OUT_DEFAULT_LEVEL=low        # low | high

# === Oracle ===
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
ORACLE_DSN=host:1521/service_name

# === Web API (src/web_api) ===
SHIFT_DURATION_MIN=480       # phút/ca chuẩn dùng để tính FTE = present_min / SHIFT_DURATION_MIN

# === Storage / sync ===
SQLITE_BUFFER_PATH=data/buffer.db
SYNC_INTERVAL_S=60
RETENTION_DAYS=7              # giữ row đã sync (synced=1) bao lâu trước khi tự dọn khỏi SQLite local
STATUS_UPDATE_INTERVAL_S=5   # chu kỳ ghi machine_status (present_now/last_seen/sensor_ok) lên Oracle cho tab Giám sát

# === Misc ===
LOG_LEVEL=INFO
